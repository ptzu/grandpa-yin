# LINE Bot 設定
CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
CHANNEL_SECRET=your_line_channel_secret_here

# Replicate API 設定
REPLICATE_API_TOKEN=your_replicate_api_token_here

# 應用程式設定
# 部署模式：platform（整合進 Altide 共用帳號層，讀寫 public.accounts/transactions）
# 或 standalone（獨立運作，身份與點數放在 grandpa_yin.subjects/wallet_transactions，
# 不需要 Altide）。未設定時預設 platform，維持既有線上行為。
DEPLOY_MODE=platform
PORT=5000
# 本地開發時設為 True 可自動重載，生產環境請保持 False
FLASK_DEBUG=False
# 日誌層級：DEBUG / INFO / WARNING / ERROR（預設 INFO）
LOG_LEVEL=INFO
# 圖片處理併發：背景執行緒池同時處理張數 / 排隊上限（預設 4 / 8）
IMAGE_WORKERS=4
IMAGE_QUEUE_LIMIT=8
# Sentry 錯誤追蹤（可選，留空則不啟用）
SENTRY_DSN=
# Sentry 環境標籤，用來區分 production / staging（預設 production）
SENTRY_ENVIRONMENT=production

# Database 資料庫設定（會員系統）
DATABASE_URL=postgresql://user:password@host:port/dbname
# Example for Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# Supabase Storage（圖片編輯流程的圖片暫存；未設定時退回 base64 存資料庫 state）
# SUPABASE_URL=https://[PROJECT-ID].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# SUPABASE_STORAGE_BUCKET=linebot-temp-images

# 模型與點數設定在 config/models.yml，不在這裡。
# 下面這些是「臨時覆寫」：設了就蓋過設定檔，適合線上不部署就調價／換模型。
# 平常請保持註解，否則改了 config/models.yml 會看不出效果。
# COLORIZE_COST=10
# EDIT_COST=5
# COLORIZE_MODEL=flux-kontext-apps/restore-image
# EDIT_MODEL=google/nano-banana

# Member Registration 會員註冊設定
WELCOME_POINTS=50

# 本地開發：ngrok 固定網址（領了 static domain 再填，webhook 網址就永久不變；
# 未設定時 start_local_server.py 用隨機網址並自動重設 webhook）
# NGROK_DOMAIN=your-name.ngrok-free.app

# 註：RAILWAY_GIT_COMMIT_SHA 由 Railway 部署時自動注入（用於錯誤追蹤標記版本），
# 本地不需設定。