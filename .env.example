# ============================================================================
# Railway 部署參考。分兩區：
#   REQUIRED  — 缺了會讓某個功能無法運作，一定要設，不要註解掉。
#   OPTIONAL  — 有安全預設或缺了只是降級，保持註解即可。
# 在 Railway 的 Variables 逐一填入 REQUIRED 區的每一個。密鑰不進 git。
# ============================================================================


# ═══════════════════════════ REQUIRED（都要設）═══════════════════════════

# --- LINE Messaging API（bot 本體；缺了服務起不來）---------------------------
# LINE Developers Console > 你的 Messaging API channel：
#   Messaging API 分頁  > Channel access token
#   Basic settings 分頁 > Channel secret
CHANNEL_ACCESS_TOKEN=your_channel_access_token
CHANNEL_SECRET=your_channel_secret

# --- Replicate（AI 影像模型；缺了服務起不來）--------------------------------
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token

# --- 資料庫（會員、點數、對話狀態；缺了幾乎所有功能都廢）---------------------
# Postgres 連線字串。Supabase：Project Settings > Database。
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- 部署模式（決定帳號/點數來源）-------------------------------------------
# standalone = 自成一套（grandpa_yin.*，不需 Altide）
# platform   = 共用 Altide 的 public.accounts/transactions
DEPLOY_MODE=standalone

# --- Supabase Storage（圖片暫存、成品保留 30 天；正式環境必需）--------------
# 缺了圖片會塞進 DB 的 JSONB（膨脹），且成品 30 天保存失效（隔天回看破圖）。
# Supabase：Project Settings > API / Storage。用 service role（secret）key。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- 金流 ECPay（付款/儲值/禮物卡；四個要嘛全設，缺一個金流就整組停用）------
# 前三個去 ECPay 拿：
#   測試站  https://developers.ecpay.com.tw/2856/ （公開，免申請）
#   正式站  https://vendor.ecpay.com.tw > 系統開發管理 > 系統介接設定 > 介接資訊
# API URL 是固定端點，只有測試/正式之分；換站時四個一起換（測試密鑰配正式網址會全部驗簽失敗）：
#   測試站  https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
#   正式站  https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
# 現成的測試特店（測試卡 4311-9511-1111-1111，安全碼任意三碼）：
#   ECPAY_MERCHANT_ID=3002607
#   ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
#   ECPAY_HASH_IV=EkRm7iFT261dpevs
ECPAY_MERCHANT_ID=your_merchant_id
ECPAY_HASH_KEY=your_hash_key
ECPAY_HASH_IV=your_hash_iv
ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# --- LIFF + LINE Login（付款頁、禮物卡；缺了付款/送禮無法運作）--------------
# 都在「LINE Login channel」底下拿（跟 Messaging API 是不同 channel、同一 Provider）：
#   Basic settings 分頁 > Channel ID          = LINE_LOGIN_CHANNEL_ID
#   LIFF 分頁 > 建一個 app > LIFF ID           = LIFF_ID（前半段＝Channel ID）
# 建 LIFF app：Size=Full、Scopes 勾 profile+openid、開啟 Share target picker、
# Endpoint URL 填「服務根網址」https://<your-app>/（不是 /pay；頁面由 ?p= 決定）。
LIFF_ID=1234567890-abcdefgh
LINE_LOGIN_CHANNEL_ID=1234567890

# --- 對外網址（禮物卡連結；缺了 bot 完全不提禮物卡）-------------------------
# 服務對外 origin（scheme+host，結尾不加斜線）。Railway 部署後填你的網域。
PUBLIC_BASE_URL=https://your-app.up.railway.app

# --- Bot 的 LINE ID（禮物卡「收下禮物」按鈕、加好友引導）--------------------
# Messaging API channel 的 Bot basic ID，含 @。
LINE_BASIC_ID=@your_bot_id


# ═══════════════════════════ OPTIONAL（可不設）═══════════════════════════

# Supabase bucket 名稱，預設 linebot-temp-images
# SUPABASE_STORAGE_BUCKET=linebot-temp-images

# 本機 Flask dev 用的 port；Railway 由平台注入，gunicorn 不讀這個
# PORT=5000

# 本機開發自動重載；正式保持 False
# FLASK_DEBUG=False

# 日誌層級 DEBUG / INFO / WARNING / ERROR（預設 INFO）
# LOG_LEVEL=INFO

# 圖片處理併發 / 排隊上限（預設 4 / 8）
# IMAGE_WORKERS=4
# IMAGE_QUEUE_LIMIT=8

# Sentry 錯誤追蹤；不設就不啟用
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# 本機 ngrok 固定網域（只有 start_local_server.py 用；Railway 用不到）
# NGROK_DOMAIN=your-name.ngrok-free.dev

# 臨時覆寫 config/settings.yml（不部署就調價/換模型）；平常保持註解，
# 否則改 settings.yml 會看不出效果
# COLORIZE_COST=10
# EDIT_COST=5
# COLORIZE_MODEL=flux-kontext-apps/restore-image
# EDIT_MODEL=google/nano-banana
# WELCOME_POINTS=50

# RAILWAY_GIT_COMMIT_SHA 由 Railway 自動注入，不用手設。
