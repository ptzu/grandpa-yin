# ============================================================================
# Copy to .env and fill in. Grouped by concern; each var says what it does and
# where to get it. Anything commented out is optional or has a safe default.
# ============================================================================

# --- LINE Messaging API (the bot itself) ------------------------------------
# From LINE Developers Console > your Messaging API channel.
#   Messaging API tab  > Channel access token
#   Basic settings tab > Channel secret
CHANNEL_ACCESS_TOKEN=your_channel_access_token
CHANNEL_SECRET=your_channel_secret

# --- Replicate (the AI image models) ----------------------------------------
# API token from https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token

# --- Database (members, points, sessions) -----------------------------------
# Postgres connection string. For Supabase: Project Settings > Database.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Supabase Storage (image staging; required in production) ---------------
# Without it, images fall back to base64 in the DB and 30-day result archiving
# stops working. From Supabase: Project Settings > API / Storage.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key      # secret, not the anon key
# SUPABASE_STORAGE_BUCKET=linebot-temp-images          # default shown

# --- Payments: ECPay gateway ------------------------------------------------
# All four required to enable paying; miss any one and top-up/gift stay off
# (the rest of the bot runs fine). Keys are secrets — never put them in
# config/settings.yml (that file is in git). Point packages live in settings.yml.
#
# Get the first three from ECPay:
#   Test:       https://developers.ecpay.com.tw/2856/ (public, no signup)
#   Production: https://vendor.ecpay.com.tw > System > Integration Info
#
# The API URL is a fixed endpoint, not something from the dashboard — only test
# vs production differ. Switch all four together: test keys + production URL
# fail every signature check.
#
# Ready-to-use test set (ECPay's public test merchant; test card
# 4311-9511-1111-1111, any 3-digit CVC):
#   ECPAY_MERCHANT_ID=3002607
#   ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
#   ECPAY_HASH_IV=EkRm7iFT261dpevs
#   ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5
# Production API URL: https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
# ECPAY_MERCHANT_ID=your_merchant_id
# ECPAY_HASH_KEY=your_hash_key
# ECPAY_HASH_IV=your_hash_iv
# ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# --- Payments: LIFF + LINE Login (payment page & gift flow) -----------------
# Both come from a LINE LOGIN channel (not the Messaging API one), under the
# same Provider:
#   Basic settings tab > Channel ID   = LINE_LOGIN_CHANNEL_ID
#   LIFF tab > add an app > LIFF ID    = LIFF_ID   (its prefix = the Channel ID)
#
# When creating the LIFF app:
#   - Size: Full
#   - Scopes: profile + openid
#   - Enable "Share target picker" (needed to pick a friend when gifting)
#   - Endpoint URL: the service ROOT, e.g. https://your-app/  (NOT /pay)
#     One app, one endpoint; pages are chosen by query (?p=pay / ?p=share /
#     ?p=claim), so the endpoint must stay the bare root.
#
# LINE_LOGIN_CHANNEL_ID verifies the ID token from the payment page (proves who
# is ordering). Without it /pay/checkout returns 401.
# LIFF_ID=1234567890-abcdefgh
# LINE_LOGIN_CHANNEL_ID=1234567890

# --- Public URL ------------------------------------------------------------
# This service's public origin (scheme + host, no trailing slash). Usually
# inferred from X-Forwarded-* headers, but the gift flow needs it explicitly:
# the bot builds gift links outside any HTTP request. Unset = bot won't offer
# gifting at all.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# Bot's LINE basic ID (with @), from the Messaging API channel. Optional:
# only used as a fallback claim link when LIFF isn't configured.
# LINE_BASIC_ID=@your_bot_id

# --- App runtime ------------------------------------------------------------
# platform = share Altide's public.accounts/transactions (default)
# standalone = self-contained in grandpa_yin.* (no Altide needed)
DEPLOY_MODE=platform
PORT=5000
FLASK_DEBUG=False                 # True only for local dev (auto-reload)
LOG_LEVEL=INFO                    # DEBUG / INFO / WARNING / ERROR
IMAGE_WORKERS=4                   # background image workers / queue limit
IMAGE_QUEUE_LIMIT=8

# --- Error tracking (optional) ----------------------------------------------
# Sentry DSN; leave blank to disable. From your Sentry project settings.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production      # production / staging

# --- Local dev: ngrok -------------------------------------------------------
# Reserve a static domain at https://dashboard.ngrok.com/domains so the webhook
# URL never changes. Unset = start_local_server.py uses a random URL each run.
# NGROK_DOMAIN=your-name.ngrok-free.dev

# --- Config overrides (optional) --------------------------------------------
# Models / points / welcome bonus live in config/settings.yml. These env vars
# OVERRIDE that file — handy for tweaking prod without a deploy. Keep them
# commented normally, or edits to settings.yml won't appear to take effect.
# COLORIZE_COST=10
# EDIT_COST=5
# COLORIZE_MODEL=flux-kontext-apps/restore-image
# EDIT_MODEL=google/nano-banana
# WELCOME_POINTS=50

# RAILWAY_GIT_COMMIT_SHA is injected automatically by Railway; no need to set it.
